<div class="layout_full portfolio block{{ class }}" itemscope itemtype="http://schema.org/Article">

    <h1 itemprop="name">{{ headline|insert_tag_raw }}</h1>
    <p class="portfolio__client">
        {{ client|default|insert_tag_raw }}
    </p>

    {% if hasText and hasText.invoke() %}
        {{ text|raw }}
    {% else %}
        <div class="teaser block">
            {{ teaser|default|sanitize_html('contao')|csp_inline_styles|insert_tag_raw }}
        </div>
    {% endif %}

</div>
